{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Adehun (remote API, dev config)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=config.dev.json"]
    },
    {
      "name": "Adehun (local API, iOS simulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=config.local.json"]
    },
    {
      "name": "Adehun (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": ["--dart-define-from-file=config.dev.json"]
    }
  ]
}
